# Database (Postgres)
POSTGRES_USER=eco_user
POSTGRES_PASSWORD=eco_pass
POSTGRES_DB=eco_db

# MongoDB
MONGO_INITDB_ROOT_USERNAME=eco_mongo
MONGO_INITDB_ROOT_PASSWORD=eco_mongo_pass

# Postgres (connection string for Go, migrate, etc.)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_URL=postgres://eco_user:eco_pass@localhost:5432/eco_db?sslmode=disable

# MongoDB
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_URI=mongodb://eco_mongo:eco_mongo_pass@localhost:27017
